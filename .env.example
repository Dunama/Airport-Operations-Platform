.env.example
# Local (docker compose overrides DATABASE_URL for the api service)

DATABASE_URL=postgresql+asyncpg://airport:airport@localhost:5432/airport

JWT_SECRET=change-me

CORS_ORIGINS=["http://localhost:3000"]

# Production (Neon): asyncpg needs ?ssl=require, NOT ?sslmode=require,

# and drop any &channel_binding=... part Neon adds to its connection string

# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require
